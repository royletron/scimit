{
  "name": "scimit",
  "version": "1.7.0",
  "description": "A local SCIM 2.0 sink — capture, inspect, and debug IDP provisioning requests",
  "type": "module",
  "bin": {
    "scimit": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run build -w scimit-frontend && npm run build -w scimit-cli && npm run build -w scimit-backend",
    "start": "node dist/cli.js",
    "dev": "concurrently -n backend,frontend -c cyan,magenta \"npm run dev -w scimit-backend\" \"npm run dev -w scimit-frontend\"",
    "prepublishOnly": "npm run build",
    "version": "node scripts/changelog.mjs && git add CHANGELOG.md"
  },
  "workspaces": [
    "backend",
    "cli",
    "frontend"
  ],
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "selfsigned": "^5.5.0",
    "uuid": "^13.0.0",
    "xml-crypto": "^6.4.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "keywords": [
    "scim",
    "identity",
    "provisioning",
    "okta",
    "entra",
    "debug"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/royletron/scimit"
  },
  "license": "ISC"
}
